# Copy this file to ".env" (same folder as docker-compose.yml) and change EVERY value below.
# Docker Compose reads it automatically.

# --- Database ---
DB_ROOT_PASSWORD=root-change-me
DB_USER=anora
DB_PASSWORD=change-me

# --- Admin page (add records) ---
# Password you type on /admin/login
ADMIN_PASSWORD=choose-a-strong-password
# Long random string used to sign the login cookie, e.g. 40+ random characters
SESSION_SECRET=replace-with-a-long-random-string
# Shared secret between the website and the PHP API for write requests. Also long and random.
API_WRITE_KEY=replace-with-another-long-random-string
# Set to true only when the site is served over https
COOKIE_SECURE=false

# --- Shown in the site header/footer ---
NEXT_PUBLIC_SWIMMER_NAME=Anora
NEXT_PUBLIC_CLUB_NAME=Your Club Name
